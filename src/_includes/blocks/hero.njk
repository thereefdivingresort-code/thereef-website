{# 積木：首頁開場。圖＝ home_bg1_hero（直式 1:2，海平面約在圖高 31%，右側留字） #}
<section class="block hero" id="top">
  <div class="wrap hero-grid">
    <div class="hero-media">
      <img src="/assets/img/home/home_bg1_hero.webp" alt="綠島山景與海平面" loading="eager">
    </div>
    <div class="hero-text">
      <p class="eyebrow hero-eyebrow"><span>{{ b.eyebrowTop }}</span> {{ b.eyebrowSub }}</p>
      <h1>{{ b.title }}</h1>
      <p class="hero-lead">{{ b.lead }}</p>
      <div class="hero-ctas">
        <a class="btn btn-outline-navy" href="{{ b.secondary.href }}">{{ b.secondary.label }} →</a>
        <a class="btn btn-orange" href="{{ b.primary.href }}">{{ b.primary.label }}</a>
      </div>
    </div>
  </div>
  <div class="hero-scrolldown">
    <span class="depth-mark">{{ b.depthLabel }}</span>
    <span class="scroll-cue">{{ b.scrollCue }}<i aria-hidden="true">⌄</i></span>
  </div>
</section>
