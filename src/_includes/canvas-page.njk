{%- macro fishItem(it, dir) -%}
      <div class="hc-fish hc-fish-{{ it.file }}" style="left:{{ it.x }}px;top:{{ it.y }}px;width:{{ it.w }}px;height:{{ it.h }}px;{% if it.rot %}transform:rotate({{ it.rot }}deg);{% endif %}{% if it.crop %}overflow:hidden;{% endif %}">
        <img class="hc-fish-img{% if it.anim.float %} has-float{% endif %}{% if it.anim.sway %} has-sway{% endif %}{% if it.anim.famp %}--famp:{{ it.anim.famp }}px;{% endif %}{% if it.anim.samp %}--samp:{{ it.anim.samp }}deg;{% endif %}{% if it.anim.bob %} has-bob{% endif %}{% if it.anim.wobble %} has-wobble{% endif %}" src="/assets/img/{{ dir }}/{{ it.file }}.webp" alt="{{ '' if lang == 'en' else it.name + '插圖' }}" loading="lazy"
          style="--dx:{{ it.anim.dx }}px;--dy:{{ it.anim.dy }}px;--dur:{{ it.anim.dur }}s;--delay:{{ it.anim.delay }}s;--float:{{ it.anim.float or 0 }}s;{% if it.anim.sway %}--sway:{{ it.anim.sway }}s;transform-origin:{{ it.anim.origin }};{% endif %}{% if it.anim.famp %}--famp:{{ it.anim.famp }}px;{% endif %}{% if it.anim.samp %}--samp:{{ it.anim.samp }}deg;{% endif %}{% if it.anim.bob %}--bob:{{ it.anim.bob }}s;--amp:{{ it.anim.amp }}px;{% endif %}{% if it.anim.wobble %}--wob:{{ it.anim.wobble }}s;{% endif %}{% if it.crop %}position:absolute;left:{{ it.crop.x }}px;top:{{ it.crop.y }}px;width:{{ it.crop.w }}px;height:{{ it.crop.h }}px;{% endif %}">
      </div>
{%- endmacro -%}
{%- macro item(it, dx, dy, active, m) -%}
      {%- set mm = m or {} -%}
      {% if it.kind == "text" %}
      <{{ 'label' if it.labelFor else 'div' }}{% if it.labelFor %} for="{{ it.labelFor }}"{% endif %} class="hc-t{% if it.ul %} ul{% endif %}{% if mm.cls %} {{ mm.cls }}{% endif %}"{% if it.id %} data-id="{{ it.id }}"{% endif %} style="left:{{ it.x + dx }}px;top:{{ it.y + dy }}px;width:{{ it.w }}px;font-size:{{ it.fs }}px;--fs:{{ it.fs }};{{ mm.vars }}font-weight:{{ it.fw }};color:{{ it.color }};line-height:{{ it.lh }};text-align:{{ ('left' if lang == 'en' else 'justify') if it.align == 'left' else it.align }};{% if it.ls %}letter-spacing:{{ it.ls }}em;{% endif %}{% if it.op %}opacity:{{ it.op }};{% endif %}">{% if mm.join %}{{ textBody(it, active) | replace("\n", '<span class="nl">\n</span>') | safe }}{% else %}{{ textBody(it, active) | safe }}{% endif %}</{{ 'label' if it.labelFor else 'div' }}>
      {% elif it.kind == "button" %}
      <a class="hc-btn{% if mm.cls %} {{ mm.cls }}{% endif %}"{% if it.id %} data-id="{{ it.id }}"{% endif %} href="{{ site.company.lineUrl if it.href == 'site:lineUrl' else it.href }}"{% if it.newTab %} target="_blank" rel="noopener"{% endif %} style="{{ mm.vars }}left:{{ it.x + dx }}px;top:{{ it.y + dy }}px;width:{{ it.w }}px;height:{{ it.h }}px;border-radius:{{ it.radius }}px;background:{{ it.bg }};color:{{ it.color }};font-size:{{ it.fs }}px;{% if it.bw %}border:{{ it.bw }}px solid {{ it.bc }};{% endif %}">{{ it.label }}</a>
      {% elif it.kind == "faq" %}
      <div class="hc-faq" style="left:{{ it.x + dx }}px;top:{{ it.y + dy }}px;width:{{ it.w }}px;--row:{{ it.rowH }}px;--line:{{ it.lineH }}px;--line-op:{{ it.lineOp }};--qfs:{{ it.q.fs }}px;--qc:{{ it.q.color }};--qlh:{{ it.q.lh }};--afs:{{ it.a.fs }}px;--ac:{{ it.a.color }};--alh:{{ it.a.lh }};--aw:{{ it.a.w }}px;--sfs:{{ it.sign.fs }}px;--sc:{{ it.sign.color }}">
        {% for f in it.items %}
        <details{% if f.open %} open{% endif %}>
          <summary><span class="q">{{ f.q }}</span><span class="sign" aria-hidden="true"></span></summary>
          <p class="a">{{ f.a | fillPrices(prices) }}</p>
        </details>
        {% endfor %}
      </div>
      {% elif it.kind == "form" %}
      <form id="{{ it.id }}" class="hc-form" action="#" method="post" aria-label="{{ 'Message form' if lang == 'en' else '留言表單' }}"></form>
      {% elif it.kind == "field" %}
      {%- set fst = "left:" ~ (it.x + dx) ~ "px;top:" ~ (it.y + dy) ~ "px;width:" ~ it.w ~ "px;height:" ~ it.h ~ "px;border-radius:" ~ it.radius ~ "px;padding:" ~ it.padT ~ "px " ~ it.padL ~ "px " ~ (it.padB or 0) ~ "px " ~ it.padL ~ "px;font-size:" ~ it.fs ~ "px;line-height:" ~ it.lh ~ ";--ph:" ~ it.phColor %}
      {% if it.tag == "select" %}
      {#- 下拉清單：自己畫（固定高度、超過就在清單裡捲動）；真的 select 藏在底下，負責必填檢查與送出的值 #}
      <div class="hc-dd" data-dd style="left:{{ it.x + dx }}px;top:{{ it.y + dy }}px;width:{{ it.w }}px;height:{{ it.h }}px;--ph:{{ it.phColor }};--fs:{{ it.fs }}px">
        <select class="hc-dd-native" id="{{ it.fid }}" name="{{ it.name }}" form="{{ it.form }}"{% if it.required %} required{% endif %} tabindex="-1" aria-hidden="true">
          <option value="">{{ it.ph }}</option>
          {% for o in it.options %}<option>{{ o }}</option>{% endfor %}
        </select>
        <button type="button" class="hc-field hc-dd-btn is-empty" id="{{ it.fid }}-btn" aria-haspopup="listbox" aria-expanded="false" aria-controls="{{ it.fid }}-list" style="left:0;top:0;width:{{ it.w }}px;height:{{ it.h }}px;border-radius:{{ it.radius }}px;padding:{{ it.padT }}px 40px {{ it.padB or 0 }}px {{ it.padL }}px;font-size:{{ it.fs }}px;line-height:{{ it.lh }};--ph:{{ it.phColor }}" data-ph="{{ it.ph }}">{{ it.ph }}</button>
        <span class="hc-select-arrow" aria-hidden="true" style="left:{{ it.arrowX }}px;top:{{ it.padT }}px;font-size:{{ it.fs }}px;line-height:{{ it.lh }};color:{{ it.phColor }}">▾</span>
        <ul class="hc-dd-list" id="{{ it.fid }}-list" role="listbox" hidden>
          {% for o in it.options %}<li role="option" aria-selected="false" data-v="{{ o }}">{{ o }}</li>{% endfor %}
        </ul>
      </div>
      {% elif it.tag == "textarea" %}
      <textarea class="hc-field" id="{{ it.fid }}" name="{{ it.name }}" form="{{ it.form }}" placeholder="{{ it.ph }}"{% if it.required %} required{% endif %} style="{{ fst }}"></textarea>
      {% else %}
      <input class="hc-field" id="{{ it.fid }}" name="{{ it.name }}" form="{{ it.form }}" type="{{ it.type }}" placeholder="{{ it.ph }}"{% if it.autocomplete %} autocomplete="{{ it.autocomplete }}"{% endif %}{% if it.required %} required{% endif %} style="{{ fst }}">
      {% endif %}
      {% elif it.kind == "check" %}
      <input class="hc-check" type="checkbox" id="{{ it.fid }}" name="{{ it.name }}" form="{{ it.form }}"{% if it.required %} required{% endif %} style="left:{{ it.x + dx }}px;top:{{ it.y + dy }}px;width:{{ it.w }}px;height:{{ it.h }}px;border-radius:{{ it.radius }}px;--bc:{{ it.bc }}">
      {% elif it.kind == "submit" %}
      <button class="hc-btn hc-submit" type="submit" form="{{ it.form }}" style="left:{{ it.x + dx }}px;top:{{ it.y + dy }}px;width:{{ it.w }}px;height:{{ it.h }}px;border-radius:{{ it.radius }}px;background:{{ it.bg }};color:{{ it.color }};font-size:{{ it.fs }}px;">{{ it.label }}</button>
      {% elif it.kind == "formmsg" %}
      <p class="hc-t hc-formmsg" data-form="{{ it.form }}" role="status" aria-live="polite" hidden style="left:{{ it.x + dx }}px;top:{{ it.y + dy }}px;width:{{ it.w }}px;font-size:{{ it.fs }}px;line-height:1.4;color:{{ it.color }};">{% if lang == "en" %}Online messages are coming soon. For now, please message our <a href="{{ site.company.lineUrl }}" target="_blank" rel="noopener">LINE Official Account</a> and we'll reply as soon as we can.{% else %}線上留言開通中，請先加 <a href="{{ site.company.lineUrl }}" target="_blank" rel="noopener">LINE 官方帳號</a>留言，我們會盡快回覆你。{% endif %}</p>
      {% endif %}
{%- endmacro -%}
{#- 手機版（≤768px）：分組、插圖窗、手機頁首。電腦版 .hc-mg 是 display: contents、其他手機元件 display: none，畫面不變。設定在 _data/mobile.json，邏輯在 scripts/mobile-blocks.js #}
{%- macro mfish(f, dir) -%}
<div class="hc-fish hc-mfish hc-fish-{{ f.it.file }}" style="{{ f.style }}"><img class="hc-fish-img{% if f.it.anim.float %} has-float{% endif %}{% if f.it.anim.sway %} has-sway{% endif %}{% if f.it.anim.bob %} has-bob{% endif %}{% if f.it.anim.wobble %} has-wobble{% endif %}" src="/assets/img/{{ dir }}/{{ f.it.file }}.webp" alt="" loading="lazy" style="--dx:{{ f.it.anim.dx * f.k }}px;--dy:{{ f.it.anim.dy * f.k }}px;--dur:{{ f.it.anim.dur }}s;--delay:{{ f.it.anim.delay }}s;--float:{{ f.it.anim.float or 0 }}s;{% if f.it.anim.sway %}--sway:{{ f.it.anim.sway }}s;transform-origin:{{ f.it.anim.origin }};{% endif %}{% if f.it.anim.bob %}--bob:{{ f.it.anim.bob }}s;--amp:{{ (f.it.anim.amp * f.k) | round(1) }}px;{% endif %}{% if f.it.anim.famp %}--famp:{{ f.it.anim.famp }}px;{% endif %}{% if f.it.anim.samp %}--samp:{{ f.it.anim.samp }}deg;{% endif %}{% if f.it.anim.wobble %}--wob:{{ f.it.anim.wobble }}s;{% endif %}{{ f.cropStyle }}"></div>
{%- endmacro -%}
{%- macro mblocks(mb, active, dir) -%}
{%- for b in mb.blocks -%}
{%- if b.type == "head" %}
      <div class="hc-mg hc-mhead">
        {% if b.logo %}<a class="hc-mlogo" href="{{ '/en/' if lang == 'en' else '/' }}" aria-label="{{ site.en.brand + ' home' if lang == 'en' else site.brand + ' 首頁' }}"><span class="hc-mcrop" style="aspect-ratio:{{ b.logo.ar }}"><img src="{{ b.logo.imgs[0].src }}" alt="" loading="lazy" style="{{ b.logo.imgs[0].style }}"></span></a>{% endif %}
        {% if b.sun %}<span class="hc-msun hc-mcrop" aria-hidden="true" style="aspect-ratio:{{ b.sun.ar }}"><img src="{{ b.sun.imgs[0].src }}" alt="" loading="lazy" style="{{ b.sun.imgs[0].style }}"></span>{% endif %}
        {% for e in b.items %}{{ item(e.it, e.dx, e.dy, active, e.m) }}{% endfor %}
        <button type="button" class="hc-mnav-btn" aria-label="{{ 'Menu' if lang == 'en' else '選單' }}" aria-expanded="false"><span></span></button>
      </div>
{%- elif b.type == "scroll" %}
      <div class="hc-mscroll{% if b.cls %} {{ b.cls }}{% endif %}" aria-hidden="true"><span>{{ 'Scroll down' if lang == 'en' else '向下捲動' }}</span></div>
{%- elif b.type == "band" %}
      <div class="hc-mband{% if b.cls %} {{ b.cls }}{% endif %}" aria-hidden="true" style="aspect-ratio:{{ b.ar }};{% if b.maxW %}max-width:{{ b.maxW }}px;{% endif %}">{% for im in b.imgs %}<img class="hc-mband-bg" src="{{ im.src }}" alt="" loading="lazy" style="{{ im.style }}">{% endfor %}{% for f in b.fish %}{{ mfish(f, dir) }}{% endfor %}{% for e in b.texts %}{{ item(e.it, e.dx, e.dy, active, e.m) }}{% endfor %}</div>
{%- else %}
      <div class="hc-mg{% if b.cls %} {{ b.cls }}{% endif %}"{% if b.vars %} style="{{ b.vars }}"{% endif %}>{% for e in b.items %}{{ item(e.it, e.dx, e.dy, active, e.m) }}{% endfor %}</div>
{%- endif %}
{%- endfor %}
{%- endmacro -%}
<body id="top">
  <div class="hc-scale">
  <div class="hc hc-page-{{ canvasKey or 'home' }}" style="height:{{ cv.height }}px">
    <div class="hc-bg" aria-hidden="true">
      {% for s in cv.sections %}<img src="/assets/img/{{ imgDir }}/{{ s.img }}" alt="" width="1440" height="{{ s.height }}" style="top:{{ s.top }}px"{% if not loop.first %} loading="lazy"{% endif %}>{% endfor %}
    </div>
    <a class="hc-logo" href="{{ '/en/' if lang == 'en' else '/' }}" aria-label="{{ site.en.brand + ' home' if lang == 'en' else site.brand + ' 首頁' }}"></a>{% for a in cv.anchors or [] %}<div class="hc-anchor" id="{{ a.id }}" style="top:{{ a.y }}px;--so:{{ a | mAnchorOrder(cv.sections) }}"></div>{% endfor %}
    {% for s in cv.sections %}
    {%- set mb = s | mBlocks(canvasKey or "home", homeD, mobile, imgDir, "/" | url, cv.sections) %}
    <section class="hc-sec hc-sec-{{ s.key }}{% if mb.cls %} {{ mb.cls }}{% endif %}" data-name="{{ s.name }}" style="top:{{ s.top }}px;height:{{ s.height }}px;--so:{{ loop.index * 10 }};{{ mb.vars }}">
      {% for it in s.items %}{% if it.kind == "fish" %}
{{ fishItem(it, imgDir) }}
      {% endif %}{% endfor %}
      {#- 元素（含共用的頁首／頁尾：從首頁那一段拿元素，照 dx、dy 位移），依手機版分組輸出 #}
      {{ mblocks(mb, cv.active, imgDir) }}
    </section>
    {% endfor %}
    {#- 跟著捲動的卡片（條款頁右側目錄）：外框在 y～until 之間，裡面的卡片 position: sticky #}
    {%- for st in cv.stickies or [] %}
    <nav class="hc-stickywrap" id="{{ st.id }}" aria-label="{{ st.label }}" style="left:{{ st.x }}px;top:{{ st.y }}px;width:{{ st.w }}px;height:{{ st.until - st.y }}px">
      <div class="hc-sticky" style="top:{{ st.top }}px;width:{{ st.w }}px;height:{{ st.h }}px">
        <div class="hc-sticky-card" style="left:{{ st.card.x }}px;top:{{ st.card.y }}px;width:{{ st.card.w }}px;height:{{ st.card.h }}px;border-radius:{{ st.card.radius }}px;background:{{ st.card.bg }};opacity:{{ st.card.op }}"></div>
        {% for ln in st.lines %}<div class="hc-sticky-line" style="left:{{ ln.x }}px;top:{{ ln.y }}px;width:{{ ln.w }}px;height:{{ ln.h }}px;background:{{ ln.bg }};opacity:{{ ln.op }}"></div>{% endfor %}
        {% for im in st.imgs %}<img class="hc-sticky-img" src="/assets/img/{{ imgDir }}/{{ im.file }}.webp" alt="{{ im.alt }}" style="left:{{ im.x }}px;top:{{ im.y }}px;width:{{ im.w }}px;height:{{ im.h }}px">{% endfor %}
        {% for it in st.items %}{{ item(it, 0, 0, cv.active) }}{% endfor %}
      </div>
    </nav>
    {% endfor %}
  </div>
  {#- 互動頁（預訂）：中間是一般排版的表單（cv.flow），下面再接一段照 Canva 座標的頁尾（cv.after）。其他頁沒有這兩個設定，輸出不變 #}
  {% if cv.flow %}
  <div class="hc-flow">{% include (cv.flow | replace(".njk", "-en.njk") if lang == "en" else cv.flow) %}</div>
  {% for s in cv.after %}
  <div class="hc hc-after" style="height:{{ s.height }}px">
    <div class="hc-bg" aria-hidden="true"><img src="/assets/img/{{ imgDir }}/{{ s.img }}" alt="" width="1440" height="{{ s.height }}" style="top:0" loading="lazy"></div>
    {%- set mb = s | mBlocks(canvasKey or "home", homeD, mobile, imgDir, "/" | url, cv.sections) %}
    <section class="hc-sec hc-sec-{{ s.key }}" data-name="{{ s.name }}" style="top:0;height:{{ s.height }}px;{{ mb.vars }}">
      {{ mblocks(mb, cv.active, imgDir) }}
    </section>
  </div>
  {% endfor %}
  {% endif %}
  </div>
  {# FAQ 結構化標記（給搜尋引擎） #}
  {% for s in cv.sections %}{% for it in s.items %}{% if it.kind == "faq" %}
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for f in it.items %}{% if f.a != "答案待補" %}{% if not loop.first %},{% endif %}{"@type":"Question","name":{{ f.q | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.a | fillPrices(prices) | dump | safe }}}}{% endif %}{% endfor %}]}</script>
  {% endif %}{% endfor %}{% endfor %}
  {% include "back-to-top.njk" %}
  <script src="/assets/js/canvas-page.js" defer></script>
  <script src="/assets/js/back-to-top.js" defer></script>{% if cv.form %}
  <script src="/assets/js/contact-form.js" defer></script>{% endif %}{% for js in cv.scripts or [] %}
  <script src="{{ js }}" defer></script>{% endfor %}
</body>
</html>
