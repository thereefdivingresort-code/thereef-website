<!doctype html>
<html lang="{{ 'en' if lang == 'en' else 'zh-Hant-TW' }}">
{#
  照 Canva 座標排版的頁面（電腦版 1440 寬）：首頁、課程…共用這一份版型。
  - 頁面在 front matter 用 canvasKey 指定讀哪一份資料：home → _data/home.json、courses → _data/courses.json
  - 底圖：每段一張 WebP（Canva 去掉文字、按鈕之後匯出），疊在最下層；圖檔在 /assets/img/<imgDir>/
  - 文字、按鈕、魚：照資料檔座標放回（以 1440 寬為準，窄螢幕整頁等比縮小）
  - 頁首、頁尾：其他頁用 section.shared 直接拿首頁（home.json）的那幾個元素，所以全站只有一份
  - 價格：一律從 _data/prices.json 讀
#}
{%- set cvMap = { "home": home, "courses": courses, "stay": stay, "trips": trips, "about": about, "booking": booking, "terms": terms, "privacy": privacy, "refund": refund } -%}
{%- set cv = cvMap[canvasKey or "home"] -%}
{%- set homeD = home -%}
{#- 英文版（front matter lang: en）：文字照 _data/en/<頁>.json 換成英文、站內連結改 /en/…（scripts/i18n.js） #}
{%- if lang == "en" -%}{%- set cv = cv | toEn(en[canvasKey or "home"]) -%}{%- set homeD = home | toEn(en.home) -%}{%- endif -%}
{%- set zhUrl = page.url | zhUrl -%}{%- set enUrl = page.url | enUrlOf -%}
{%- set imgDir = cv.imgDir or "home" -%}
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if lang == "en" %}{{ title }} | {{ site.en.brand }}{% else %}{{ title }}｜{{ site.brand }}{% endif %}</title>
  <link rel="alternate" hreflang="zh-Hant" href="{{ zhUrl }}">
  <link rel="alternate" hreflang="en" href="{{ enUrl }}">
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/canvas-page.css">
  <link rel="stylesheet" href="/assets/css/canvas-mobile.css" media="(max-width: 768px)">
  <link rel="stylesheet" href="/assets/css/back-to-top.css">{% if cv.css %}
  <link rel="stylesheet" href="{{ cv.css }}">{% endif %}
  <script>if (!(window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches) && "IntersectionObserver" in window) document.documentElement.classList.add("hc-anim");</script>
</head>
{#- 英文版：讀 site.json 的公司資訊、連結，組成英文句子（中文版見下面 textBody） #}
